APP_BASE_URL=http://localhost:3100
# For direct Next.js startup through ngrok, set APP_BASE_URL to the public HTTPS origin.
# The companion stack launcher derives it from backend RECRUITMENT_PUBLIC_APP_URL.
# Use the restricted recruitment_auth role on the same database as the Frontdesk API.
RECRUITMENT_AUTH_DATABASE_URL=postgresql://recruitment_auth:replace-with-your-role-password@localhost:55439/recruitment_auth_dev
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
RECRUITMENT_API_BASE_URL=http://127.0.0.1:8000
# Match the provider mode configured for the companion API and worker.
RECRUITMENT_PROVIDER_MODE=fake
# Optional Google login/signup. Both must be set; keep them server-side.
# The existing Gmail OAuth web client can be reused with this additional redirect:
# APP_BASE_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email verification delivery is not configured.
